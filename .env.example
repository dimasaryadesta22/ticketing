# Salin menjadi .env lalu isi nilainya:  cp .env.example .env
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# Untuk Jenkins, isi file .env ini di-upload sebagai Credentials "Secret file" dengan ID: tiketin-env
# Gunakan huruf/angka saja untuk password (tanpa @ : / # ?) agar DATABASE_URL tidak rusak.

# Username Docker Hub pemilik image (image: <DOCKERHUB_USER>/tiketin:latest)
DOCKERHUB_USER=GANTI_USERNAME

# Port aplikasi di host
APP_PORT=8000

# Database PostgreSQL
POSTGRES_DB=tiketin
POSTGRES_USER=tiketin
POSTGRES_PASSWORD=GantiPasswordDatabase123

# Kunci penandatanganan token login (isi string acak panjang)
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter

# Akun admin awal yang dibuat seeder
ADMIN_EMAIL=admin@tiketin.local
ADMIN_PASSWORD=GantiPasswordAdmin123
